<form method="post" action="{{ 'Item_Project'|itemtype_form_path }}" class="mb-2">
    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
    <input type="hidden" name="items_id" value="{{ item.getID() }}">
    <input type="hidden" name="itemtype" value="{{ get_class(item) }}">
    <div class="d-flex">
        {{ 'Project'|itemtype_dropdown({
            'entity': item.getEntity(),
            'used': used,
        }) }}
    </div>
    <div class="d-flex flex-row-reverse pe-2">
        <input name="add" id="add" type="submit" class="btn btn-primary" value="{{ _x('button', 'Add') }}">
    </div>
</form>

<table class="table table-striped">
  <thead>
    <tr>
        {% for column in data['columns'] %}
            <th>{{ column }}</th>
        {% endfor %}
    </tr>
  </thead>
  <tbody>
    {% for entries in data['entries'] %}
        <tr>
            {% for key, value in entries %}
                {% if key == 'projectstates_id' or key == 'priority' %}
                    <td style="background: {{ value['color'] }}">{{ value['content']|raw }}</td>
                {% else %}
                    <td>{{ value|raw }}</td>
                {% endif %}
            {% endfor %}
        </tr>
    {% endfor %}
  </tbody>
  <thead>
    <tr>
        {% for column in data['columns'] %}
            <th>{{ column }}</th>
        {% endfor %}
    </tr>
  </thead>
</table>
