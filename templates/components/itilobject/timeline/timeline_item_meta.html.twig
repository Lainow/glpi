{#
 # Author and time displayed above a timeline card.
 #
 # Expected variables:
 #  - users_id:     author of the entry
 #  - user_object:  author, if already loaded (optional)
 #  - anonym_user:  whether the author must be anonymized
 #  - date:         creation date of the entry
 #  - anchor:       anchor of the entry
 #  - is_right:     whether the entry is displayed on the right side
 #}

<div class="timeline-meta {{ is_right ? 'timeline-meta-right' : '' }}">
   {% if users_id > 0 %}
      <span class="timeline-author">
         {{ include('components/user/link_with_tooltip.html.twig', {
            'users_id': users_id,
            'user_object': user_object ?? null,
            'enable_anonymization': anonym_user,
         }, with_context = false) }}
      </span>
   {% endif %}
   <a class="timeline-time" href="#{{ anchor }}" title="{{ date|formatted_datetime }}" data-bs-toggle="tooltip">
      {{ date|date('H:i') }}
   </a>
</div>
