{#
 # Type badge displayed on top of a timeline card.
 #
 # Expected variables:
 #  - itiltype:           type of the entry (ITILFollowup, ITILTask, ...)
 #  - timeline_itemtypes: types the timeline can display, to get the icon
 #}

{% set type_labels = {
   'ITILFollowup': _n('Followup', 'Followups', 1),
   'ITILTask': _n('Task', 'Tasks', 1),
   'ITILSolution': _n('Solution', 'Solutions', 1),
   'ITILValidation': 'CommonITILValidation'|itemtype_name(1),
   'Document_Item': _n('Document', 'Documents', 1),
} %}
{% set type_icon = (timeline_itemtypes|default([])|filter((v) => v.type == itiltype)|first).icon|default('') %}

{% if type_labels[itiltype] is defined %}
   <span class="timeline-type-badge me-2">
      {% if type_icon %}<i class="{{ type_icon }}" aria-hidden="true"></i>{% endif %}
      {{ type_labels[itiltype] }}
   </span>
{% endif %}
